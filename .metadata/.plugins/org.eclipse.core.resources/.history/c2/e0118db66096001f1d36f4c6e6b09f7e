package co.edu.uco.ucobet.businesslogic.facade.city.impl;

import co.edu.uco.crosscutting.exceptions.UcoApplicationException;
import co.edu.uco.ucobet.businesslogic.facade.city.RegisterNewCityFacede;
import co.edu.uco.ucobet.crosscutting.exceptions.BusinessLogicUcoBetException;
import co.edu.uco.ucobet.crosscutting.exceptions.UcoBetException;
import co.edu.uco.ucobet.data.dao.CityDAO;
import co.edu.uco.ucobet.data.dao.DAOFactory;
import co.edu.uco.ucobet.data.dao.enums.DAOsource;

public final class RegisterNewCityFacedeImpl implements RegisterNewCityFacede {

	@Override
	public void execute(CityDAO data) {
		var factory = DAOFactory.getFactory(DAOsource.SQLSERVER);
		
		try {
			factory.initTransaction();
			factory.commitTransaction();
			
		} catch (final UcoBetException exception) {
			factory.rollbackTransaction();
			throw exception;
		} catch (final Exception exception) {
			factory.rollbackTransaction();
			var userMessage = "Se ha presentado tratar de registrar la información de la nueva ciudad...";
			var technicalMessage = "Se ha presentado un ploblema inesperado registrando la información de la nueva ciudad. Por favor revise el log de errores para tener más detalles...";
			throw BusinessLogicUcoBetException.create(userMessage,technicalMessage,exception);
		} finally {
			factory.closeConnection();
		}
	}

}
